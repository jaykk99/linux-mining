# linux-mining — environment configuration
# Everything here is OPTIONAL. The miners run with zero config out of the box
# (wallet and pool are CLI args / defaults). Copy to `.env` only if you want
# to set persistent defaults. `.env` is gitignored — never commit it.

# BTC_WALLET: payout address for stratum mining scripts.
# Overrides the default placeholder address when set.
# BTC_WALLET=bc1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# BTC_POOL: pool host:port for quick_miner.py (default solo.ckpool.org:3333).
# BTC_POOL=solo.ckpool.org:3333
